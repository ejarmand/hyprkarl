theme[main_fg]       = "#eee6da"
theme[main_bg]       = "#1b1714"
theme[title]         = "#b0c0ff"
theme[hi_fg]         = "#8a9cfa"

theme[selected_bg]   = "#2a2420"
theme[selected_fg]   = "#eee6da"
theme[inactive_fg]   = "#bdb2a5"

theme[cpu_box]       = "#bdb2a5"
theme[mem_box]       = "#bdb2a5"
theme[net_box]       = "#bdb2a5"
theme[proc_box]      = "#bdb2a5"
theme[div_line]      = "#bdb2a5"

theme[graph_text]    = "#aee6b6"
theme[proc_misc]     = "#aee6b6"

# temperature gradient (semantic → keep warning scale)
theme[temp_start]    = "#1b1714"
theme[temp_mid]      = "#ecd06a"
theme[temp_end]      = "#dcb8ff"

# cpu (hot → critical)
theme[cpu_start]     = "#f48a5c"
theme[cpu_mid]       = "#ffa98f"
theme[cpu_end]       = "#dcb8ff"

# memory (capacity / availability → calm/positive)
theme[free_start]        = "#221d19"
theme[free_mid]          = "#6fd0a8"
theme[free_end]          = "#aee6b6"

theme[cached_start]      = "#221d19"
theme[cached_mid]        = "#6fd0a8"
theme[cached_end]        = "#aee6b6"

theme[available_start]   = "#221d19"
theme[available_mid]     = "#6fd0a8"
theme[available_end]     = "#aee6b6"

theme[used_start]        = "#8a9cfa"
theme[used_mid]          = "#8a9cfa"
theme[used_end]          = "#b0c0ff"

# network (distinct but not semantic-danger)
theme[download_start]    = "#8a9cfa"
theme[download_mid]      = "#8a9cfa"
theme[download_end]      = "#c78cf4"

theme[upload_start]      = "#304539"
theme[upload_mid]        = "#6fd0a8"
theme[upload_end]        = "#dcb8ff"

# process (neutral activity → use secondary)
theme[process_start]     = "#8a9cfa"
theme[process_mid]       = "#8a9cfa"
theme[process_end]       = "#b0c0ff"