theme[main_fg]       = "#efe9e0"
theme[main_bg]       = "#15191a"
theme[title]         = "#acc0ff"
theme[hi_fg]         = "#8aa6f0"

theme[selected_bg]   = "#222829"
theme[selected_fg]   = "#efe9e0"
theme[inactive_fg]   = "#b8b4ac"

theme[cpu_box]       = "#b8b4ac"
theme[mem_box]       = "#b8b4ac"
theme[net_box]       = "#b8b4ac"
theme[proc_box]      = "#b8b4ac"
theme[div_line]      = "#b8b4ac"

theme[graph_text]    = "#f4d692"
theme[proc_misc]     = "#f4d692"

# temperature gradient (semantic → keep warning scale)
theme[temp_start]    = "#15191a"
theme[temp_mid]      = "#d8bc7a"
theme[temp_end]      = "#ffa886"

# cpu (hot → critical)
theme[cpu_start]     = "#f28a64"
theme[cpu_mid]       = "#ffa886"
theme[cpu_end]       = "#ffa886"

# memory (capacity / availability → calm/positive)
theme[free_start]        = "#1b2021"
theme[free_mid]          = "#d8bc7a"
theme[free_end]          = "#f4d692"

theme[cached_start]      = "#1b2021"
theme[cached_mid]        = "#d8bc7a"
theme[cached_end]        = "#f4d692"

theme[available_start]   = "#1b2021"
theme[available_mid]     = "#d8bc7a"
theme[available_end]     = "#f4d692"

theme[used_start]        = "#8aa6f0"
theme[used_mid]          = "#8aa6f0"
theme[used_end]          = "#acc0ff"

# network (distinct but not semantic-danger)
theme[download_start]    = "#8aa6f0"
theme[download_mid]      = "#8aa6f0"
theme[download_end]      = "#f28a64"

theme[upload_start]      = "#464232"
theme[upload_mid]        = "#d8bc7a"
theme[upload_end]        = "#ffa886"

# process (neutral activity → use secondary)
theme[process_start]     = "#8aa6f0"
theme[process_mid]       = "#8aa6f0"
theme[process_end]       = "#acc0ff"