theme[main_fg]       = "#f3e8d8"
theme[main_bg]       = "#1f1714"
theme[title]         = "#92e2d2"
theme[hi_fg]         = "#6fc8b8"

theme[selected_bg]   = "#2e241f"
theme[selected_fg]   = "#f3e8d8"
theme[inactive_fg]   = "#bcb0a2"

theme[cpu_box]       = "#bcb0a2"
theme[mem_box]       = "#bcb0a2"
theme[net_box]       = "#bcb0a2"
theme[proc_box]      = "#bcb0a2"
theme[div_line]      = "#bcb0a2"

theme[graph_text]    = "#ffa486"
theme[proc_misc]     = "#ffa486"

# temperature gradient (semantic → keep warning scale)
theme[temp_start]    = "#1f1714"
theme[temp_mid]      = "#f3a64a"
theme[temp_end]      = "#ffc072"

# cpu (hot → critical)
theme[cpu_start]     = "#f28462"
theme[cpu_mid]       = "#ffa486"
theme[cpu_end]       = "#ffc072"

# memory (capacity / availability → calm/positive)
theme[free_start]        = "#261d19"
theme[free_mid]          = "#f28462"
theme[free_end]          = "#ffa486"

theme[cached_start]      = "#261d19"
theme[cached_mid]        = "#f28462"
theme[cached_end]        = "#ffa486"

theme[available_start]   = "#261d19"
theme[available_mid]     = "#f28462"
theme[available_end]     = "#ffa486"

theme[used_start]        = "#6fc8b8"
theme[used_mid]          = "#6fc8b8"
theme[used_end]          = "#92e2d2"

# network (distinct but not semantic-danger)
theme[download_start]    = "#6fc8b8"
theme[download_mid]      = "#6fc8b8"
theme[download_end]      = "#f3a64a"

theme[upload_start]      = "#543227"
theme[upload_mid]        = "#f28462"
theme[upload_end]        = "#ffc072"

# process (neutral activity → use secondary)
theme[process_start]     = "#6fc8b8"
theme[process_mid]       = "#6fc8b8"
theme[process_end]       = "#92e2d2"