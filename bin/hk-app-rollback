#!/bin/bash
# hk-app-rollback
# Swap an app's current and previous releases.
#
# Usage: hk-app-rollback <id>

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/app.sh"

id="${1:-}"
if [[ -z "$id" ]]; then
  echo "Usage: hk-app-rollback <id>" >&2
  exit 1
fi

app_load "$id"
app_lock
current=$(app_current_tag "$id")
previous=$(app_previous_tag "$id")
if [[ -z "$current" || -z "$previous" || ! -d "$APP_OPT_DIR/$id/$previous" ]]; then
  error "$id has no previous release to roll back to"
fi

app_relink "$previous" "$APP_OPT_DIR/$id/current"
app_relink "$current" "$APP_OPT_DIR/$id/previous"
app_integrate "$id"
info "Rolled $id back to $previous ($current is now previous)"
app_running "$id" && warn "$id is running: restart it to use this version"
exit 0
