#!/bin/bash
# hk-screenshot
# Capture the desktop without dismissing an open Quickshell feature panel, then
# open the capture in satty: Enter copies and saves, Ctrl+C copies, Ctrl+S
# saves, and Esc discards.

mode=${1:-}
case "$mode" in
  window | output | region) shift ;;
  *) echo "Usage: hk-screenshot <window|output|region> [hyprshot options]" >&2; exit 1 ;;
esac

# Save where and as Hyprshot would.
[[ -z "$XDG_PICTURES_DIR" ]] && XDG_PICTURES_DIR=$(xdg-user-dir PICTURES 2>/dev/null)
output_dir=${HYPRSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME}}

restore_panel_focus() {
  qs -p "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell" ipc call screenshot finish >/dev/null 2>&1
}

capture=$(mktemp --tmpdir="${XDG_RUNTIME_DIR:-/tmp}" hk-screenshot.XXXXXX.png)

# Hyprshot's selection layer clears Quickshell's focus grab, which normally
# dismisses an open panel. Release the grab first and restore it after capture.
qs -p "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell" ipc call screenshot begin >/dev/null 2>&1
trap 'restore_panel_focus; rm -f "$capture"' EXIT
hyprshot -m "$mode" --raw "$@" > "$capture"
restore_panel_focus

# A cancelled selection captures nothing.
[[ -s "$capture" ]] || exit 0

mkdir -p "$output_dir"
satty --filename "$capture" \
  --output-filename "$output_dir/%Y-%m-%d-%H%M%S_hyprshot.png" \
  --copy-command wl-copy \
  --actions-on-enter save-to-clipboard,save-to-file \
  --early-exit
