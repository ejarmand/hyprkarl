#!/bin/bash
# hk-menu-update
# Menu for system and hyprkarl updates

ROFI_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/custom-menu.rasi"

UPDATE_HK="󰚰 Update Hyprkarl"
UPGRADE_PKGS="󰏕 Upgrade Packages"
UPDATE_APPS="󰀻 Update Apps"

CHOICE=$(echo -e "$UPDATE_HK\n$UPGRADE_PKGS\n$UPDATE_APPS" |
  rofi -dmenu \
    -p "" \
    -no-custom \
    -mesg "Update" \
    -theme "$ROFI_THEME")

case "$CHOICE" in
"$UPDATE_HK") hk-tui-launch hk-update-tui ;;
"$UPGRADE_PKGS") hk-tui-launch hk-pkg-upgrade ;;
"$UPDATE_APPS") hk-tui-launch bash -c 'if hk-app-update; then hk-show-done; else hk-show-done "Update failed. Press any key to close..."; fi' ;;
"") exit 1 ;;
esac

exit 0
