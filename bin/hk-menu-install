#!/bin/bash
# hk-menu-install
# Menu for installing packages

ROFI_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/custom-menu.rasi"

PACMAN="󰣇 Pacman"
AUR=" AUR"
FLATPAK="󰏖 Flatpak"
DOCKER="󰡨 Docker"
APPIMAGE="󰀻 AppImage"

relaunch_menu() { exec "$0"; }

# Prompt for a GitHub owner/repo or AppImage URL, then install it in a terminal.
install_appimage() {
  local source
  source=$(rofi -dmenu -p "" -mesg "owner/repo or AppImage URL" -theme "$ROFI_THEME" </dev/null)
  [[ -z "$source" ]] && return 1
  hk-tui-launch bash -c 'if hk-app-install "$1"; then hk-show-done; else hk-show-done "Install failed. Press any key to close..."; fi' _ "$source"
}

CHOICE=$(echo -e "$PACMAN\n$AUR\n$FLATPAK\n$DOCKER\n$APPIMAGE" \
    | rofi -dmenu \
           -p "" \
           -no-custom \
           -mesg "Install" \
           -theme "$ROFI_THEME")

case "$CHOICE" in
    "$PACMAN")  hk-tui-launch hk-pkg-install-tui ;;
    "$AUR")     hk-tui-launch hk-pkg-install-tui --aur ;;
    "$FLATPAK") hk-tui-launch hk-pkg-install-tui --flatpak ;;
    "$DOCKER")  hk-menu-docker-install || relaunch_menu ;;
    "$APPIMAGE") install_appimage || relaunch_menu ;;
    "")         exit 1 ;;
esac

exit 0
