#!/bin/bash

# Send a sequence of keys and text to the focused window, for voice commands.
# Each argument is one step:
#   CTRL+L      a key, with optional modifiers joined by + (Hyprland key names),
#               sent with Lua's hl.dsp.send_shortcut (Hyprland 0.55+)
#   type:TEXT   paste TEXT through the clipboard
# Example: hk-voice-keys CTRL+L "type:linux voice control" Return

if (($# == 0)); then
  echo "Usage: hk-voice-keys <step>..."
  exit 1
fi

for step in "$@"; do
  if [[ $step == type:* ]]; then
    printf '%s' "${step#type:}" | wl-copy
    sleep 0.05
    hyprctl dispatch "hl.dsp.send_shortcut({ mods = 'CTRL', key = 'V' })" >/dev/null
  else
    key="${step##*+}"
    mods=""
    [[ $step == *+* ]] && mods="${step%+*}"
    hyprctl dispatch "hl.dsp.send_shortcut({ mods = '${mods//+/ }', key = '$key' })" >/dev/null
  fi
  # Give the app time to react (e.g. focus the address bar) before the next step.
  sleep 0.1
done
