#!/bin/bash
# hk-starship-reload
# Rebuild the Starship prompt config from ~/.config/starship.toml and the
# active theme's palette.
#
# Usage:
#   hk-starship-reload
#
# Starship has no include mechanism, so this writes a merged copy to
# ~/.local/state/hyprkarl/starship.toml, which STARSHIP_CONFIG points at.
# A theme's starship.toml defines [palettes.hyprkarl]; the merged copy selects
# it in place of the layout's own top-level `palette` line. Themes without a
# starship.toml use the layout unchanged. Run this after editing the layout;
# open shells pick up the result at their next prompt.

# --- Constants ---

LAYOUT="$HOME/.config/starship.toml"
THEME_PALETTE="$HOME/.config/hyprkarl/current/theme/starship.toml"
OUTPUT="$HOME/.local/state/hyprkarl/starship.toml"

# --- Script Body ---

if [[ ! -f "$LAYOUT" ]]; then
  rm -f "$OUTPUT"
  exit 0
fi

mkdir -p "$(dirname "$OUTPUT")"
tmp=$(mktemp "$OUTPUT.XXXXXX") || exit 1

if [[ -f "$THEME_PALETTE" ]]; then
  {
    echo "# Generated by hk-starship-reload; edit ~/.config/starship.toml instead." &&
      echo "palette = 'hyprkarl'" &&
      # Drop the layout's top-level palette line. A bare [table] header ends the
      # top level; powerline segments like [](...) inside format don't match.
      awk '/^[[:space:]]*\[[^]]+\][[:space:]]*$/ { in_table = 1 }
        !(!in_table && /^[[:space:]]*palette[[:space:]]*=/)' "$LAYOUT" &&
      echo &&
      cat "$THEME_PALETTE"
  } >"$tmp"
else
  cp "$LAYOUT" "$tmp"
fi

# Keep the last good output if any step above failed.
if [[ $? -ne 0 ]]; then
  rm -f "$tmp"
  echo "hk-starship-reload: failed to build $OUTPUT; kept the previous one" >&2
  exit 1
fi

# Rename into place so a prompt never reads a half-written file.
mv "$tmp" "$OUTPUT"
