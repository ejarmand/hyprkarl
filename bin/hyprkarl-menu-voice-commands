#!/bin/bash
# Voice command cheat sheet: the focused app's commands first, then the ones
# that work everywhere (from hyprkarl-voice-command --list).
# Usage:
#   hyprkarl-menu-voice-commands [back_cmd]
#   back_cmd   Optional command to invoke if the user dismisses the menu.
#              If omitted, dismissing the menu does nothing.

back_cmd="${1:-}"

hyprkarl-voice-command --list \
    | rofi -dmenu \
           -p "" \
           -no-custom \
           -mesg "Voice Commands" \
           -theme ~/.config/rofi/keybindings.rasi \
    || { pkill rofi; [[ -n "$back_cmd" ]] && $back_cmd; }
