#!/bin/bash

# Run a voice command from a dictation transcript.
# The Wispr Flow helper calls this (via WISPR_TRANSCRIPT_HOOK) with the transcript as $1.
# Exit 0: the transcript was a command and it was started, or it was pasted here
#         with the app's own paste key (terminals), so the helper skips the paste.
# Exit 1: not a command, so the helper pastes the transcript as normal text.
# Phrases live in $HYPRKARL_PATH/config/hyprkarl/voice-commands.conf; commands in an
# [app ...] section there apply only while that app's window is focused.

DRY_RUN=""
if [[ $1 == --dry-run ]]; then
  DRY_RUN=1
  shift
fi

# --list: print the phrases for the focused app and everywhere, labelled by the
# "## Title" above each group (the cheat sheet, hk-menu-voice-commands).
LIST=""
if [[ $1 == --list ]]; then
  LIST=1
  set -- ""
fi

# Tracks the window of the last dictation (for "join with") and any join mode
# set by voice. Lives in the runtime dir, so a reboot starts fresh.
STATE="${HYPRKARL_VOICE_STATE:-${XDG_RUNTIME_DIR:-/tmp}/hyprkarl-voice-state}"

# --join-mode line|paragraph|off|config: change the join mode until the next
# change ("config" goes back to the phrase file). Run by the "... mode" phrases.
if [[ $1 == --join-mode ]]; then
  if [[ $2 == config ]]; then
    rm -f "$STATE.mode"
  else
    printf '%s\n' "$2" >"$STATE.mode"
  fi
  [[ -n $DRY_RUN ]] || hyprctl notify 1 2000 0 "Dictation join: $2" >/dev/null
  exit 0
fi

if (($# == 0)); then
  echo "Usage: hk-voice-command [--dry-run] <transcript> | --list"
  exit 1
fi

CONFIG="${HYPRKARL_VOICE_COMMANDS:-${HYPRKARL_PATH:-$HOME/.local/share/hyprkarl}/config/hyprkarl/voice-commands.conf}"
[[ -r $CONFIG ]] || exit 1

declare -A CAPTURES

# Lowercase, drop apostrophes, turn other punctuation into spaces, squeeze
# spaces. Sets REPLY instead of printing: it runs for every line of the phrase
# file, and a $(...) subshell per call cost about a second per dictation.
normalize_reply() {
  local text="${1,,}"
  text="${text//[\'’]/}"
  text="${text//[^a-z0-9]/ }"
  local -a words
  read -ra words <<<"$text"
  REPLY="${words[*]}"
}

normalize() {
  normalize_reply "$1"
  echo "$REPLY"
}

# Print a spoken or written number as digits. Includes the usual mishearings.
to_number() {
  local names=(zero one two three four five six seven eight nine ten eleven
    twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen twenty)
  local i

  if [[ $1 =~ ^[0-9]+$ ]]; then
    echo "$1"
    return 0
  fi
  case $1 in
    won) echo 1; return 0 ;;
    to | too) echo 2; return 0 ;;
    for) echo 4; return 0 ;;
    file) echo 5; return 0 ;;
    ate) echo 8; return 0 ;;
  esac
  for i in "${!names[@]}"; do
    if [[ ${names[i]} == "$1" ]]; then
      echo "$i"
      return 0
    fi
  done
  return 1
}

# Match the whole transcript against one phrase, filling CAPTURES on success.
match_phrase() {
  local -a pwords twords
  local i

  read -ra pwords <<<"${1,,}"
  read -ra twords <<<"$2"
  CAPTURES=()
  for i in "${!pwords[@]}"; do
    ((i < ${#twords[@]})) || return 1
    case ${pwords[i]} in
      '<text>')
        CAPTURES[text]="${twords[*]:i}"
        return 0
        ;;
      '<n>')
        CAPTURES[n]=$(to_number "${twords[i]}") || return 1
        ;;
      *)
        [[ ${pwords[i]} == "${twords[i]}" ]] || return 1
        ;;
    esac
  done
  ((${#pwords[@]} == ${#twords[@]}))
}

# Fill placeholders into the command's words and start it detached.
run_command() {
  local -a argv
  local i

  read -ra argv <<<"$1"
  for i in "${!argv[@]}"; do
    argv[i]="${argv[i]//<n>/${CAPTURES[n]}}"
    argv[i]="${argv[i]//<text:url>/${CAPTURES[text]// /+}}"
    argv[i]="${argv[i]//<text>/${CAPTURES[text]}}"
    [[ ${argv[i]} == '~/'* ]] && argv[i]="$HOME/${argv[i]#'~/'}"
  done

  if [[ -n $DRY_RUN ]]; then
    printf '%q ' "${argv[@]}"
    echo
  else
    setsid -f "${argv[@]}" >/dev/null 2>&1
  fi
}

# Paste text into the focused app with the given keys. Not detached: the paste
# must land before the app restores its clipboard.
paste_raw() {
  local keys=$1 text=$2
  if [[ -n $DRY_RUN ]]; then
    echo "paste with $keys: $text"
    return
  fi
  printf '%s' "$text" | wl-copy
  sleep 0.05
  hk-voice-keys "$keys"
}

TRANSCRIPT=$(normalize "$1")

LEADER=$(sed -n 's/^[[:space:]]*leader[[:space:]]*=[[:space:]]*//p' "$CONFIG" | tail -n1)
LEADER=$(normalize "$LEADER")
# Without the leader nothing is a command (but it is still pasted, see below).
if [[ -n $LEADER ]]; then
  if [[ $TRANSCRIPT == "$LEADER "* ]]; then
    TRANSCRIPT="${TRANSCRIPT#"$LEADER "}"
  else
    TRANSCRIPT=""
  fi
fi

# The focused window's class (for [app ...] sections) and address (for joins).
# HYPRKARL_VOICE_CLASS / HYPRKARL_VOICE_ADDR override them for --dry-run tests.
if [[ -n ${HYPRKARL_VOICE_CLASS+set} ]]; then
  ACTIVE_CLASS=$HYPRKARL_VOICE_CLASS
  ACTIVE_ADDR=${HYPRKARL_VOICE_ADDR:-test}
else
  IFS=$'\t' read -r ACTIVE_CLASS ACTIVE_ADDR < <(hyprctl -j activewindow 2>/dev/null |
    jq -r '[.class // "", .address // ""] | @tsv')
fi

# Sort command lines into the focused app's sections and the global ones, so an
# app's command wins over a global command with the same phrase.
APP_LINES=()
GLOBAL_LINES=()
PASTE_KEY=""
SUFFIXES=()
JOIN_GLOBAL=""
JOIN_APP=""
declare -A COMPLETIONS COMPLETION_DIRS
LIST_APP=()
LIST_GLOBAL=()
title=""
section=global
while IFS= read -r line; do
  if [[ $line =~ ^##[[:space:]]+(.*) ]]; then
    title=${BASH_REMATCH[1]}
    continue
  fi
  [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
  if [[ $line =~ ^[[:space:]]*\[(.*)\][[:space:]]*$ ]]; then
    header="${BASH_REMATCH[1]}"
    pattern="${header#app }"
    if [[ $header == global ]]; then
      section=global
    elif [[ $header == 'app '* && -n $ACTIVE_CLASS && ${ACTIVE_CLASS,,} =~ ^(${pattern,,})$ ]]; then
      section=app
    else
      section=other
    fi
    continue
  fi
  [[ $line == *' = '* ]] || continue
  normalize_reply "${line%% = *}"
  key=$REPLY
  if [[ -n $LIST ]]; then
    case $key in
      leader | 'paste with' | 'join with') shown="" ;;
      'send suffix') shown="... ${line#* = }" ;;
      'complete '*' from') shown="" ;;
      'complete '*) shown="... ${key#complete } <name> ..." ;;
      *) shown=${line%% = *} ;;
    esac
    printf -v shown '%-30s %s' "$shown" "$title"
    case $section in
      app) [[ $shown != ' '* ]] && LIST_APP+=("$shown") ;;
      global) [[ $shown != ' '* ]] && LIST_GLOBAL+=("$shown") ;;
    esac
  fi
  if [[ $key == 'paste with' ]]; then
    [[ $section == app ]] && PASTE_KEY="${line#* = }"
    continue
  fi
  if [[ $key == 'join with' ]]; then
    case $section in
      global) JOIN_GLOBAL="${line#* = }" ;;
      app) JOIN_APP="${line#* = }" ;;
    esac
    continue
  fi
  # "complete <word> from = DIR...": the picker only takes names of DIRs' subdirectories
  if [[ $key == 'complete '*' from' ]]; then
    word=${key#complete }
    [[ $section == app ]] && COMPLETION_DIRS[${word% from}]="${line#* = }"
    continue
  fi
  # "complete <word> = <trigger> <accept keys>", e.g. "complete mention = @ Tab"
  if [[ $key == 'complete '* ]]; then
    [[ $section == app ]] && COMPLETIONS[${key#complete }]="${line#* = }"
    continue
  fi
  if [[ $key == 'send suffix' ]]; then
    [[ $section == global ]] && SUFFIXES+=("$(normalize "${line#* = }")")
    continue
  fi
  case $section in
    app) APP_LINES+=("$line") ;;
    global) GLOBAL_LINES+=("$line") ;;
  esac
done <"$CONFIG"

if [[ -n $LIST ]]; then
  if ((${#LIST_APP[@]})); then
    echo "── In this app ──"
    printf '%s\n' "${LIST_APP[@]}"
    echo "── Everywhere ──"
  fi
  printf '%s\n' "${LIST_GLOBAL[@]}"
  exit 0
fi

# How this dictation joins the previous one: the app's section wins (so
# terminals stay off), then a mode set by voice, then the global setting.
JOIN_MODE=${JOIN_APP:-$(cat "$STATE.mode" 2>/dev/null)}
JOIN_MODE=${JOIN_MODE:-$JOIN_GLOBAL}
case ${JOIN_MODE,,} in
  line) JOIN_KEYS=(SHIFT+Return) ;;
  paragraph) JOIN_KEYS=(SHIFT+Return SHIFT+Return) ;;
  '' | off | space | none) JOIN_KEYS=() ;;
  *) read -ra JOIN_KEYS <<<"$JOIN_MODE" ;;
esac

# Wispr trims leading whitespace off every transcript, so it cannot start a
# dictation on a new line. Consecutive dictations into the same window get the
# join keys (Shift+Enter: a new line without sending) before they are pasted;
# another window or a voice command in between starts fresh.
join_previous() {
  ((${#JOIN_KEYS[@]} > 0)) && [[ -n $ACTIVE_ADDR ]] || return 0
  [[ $(cat "$STATE.last" 2>/dev/null) == "$ACTIVE_ADDR" ]] || return 0
  if [[ -n $DRY_RUN ]]; then
    echo "join: ${JOIN_KEYS[*]}"
  else
    hk-voice-keys "${JOIN_KEYS[@]}"
  fi
}

remember_dictation() {
  printf '%s\n' "$ACTIVE_ADDR" >"$STATE.last"
}

start_fresh() {
  rm -f "$STATE.last"
}

# Pickers: "<word> <name>" (e.g. "mention alice", "skill pr ping pong") in a
# dictation opens the app's picker. The trigger and the name are typed as key
# presses, not pasted: a picker only opens on typed input, and Wispr restores
# its clipboard right after this script answers, which clobbered pasted ones.
# Wispr does the same for Cursor file tags (it types "@", the name, then Tab).

# Print the names a word's picker may take: its "from" dirs' subdirectories.
completion_names() {
  local dir path
  local -a dirs
  read -ra dirs <<<"${COMPLETION_DIRS[$1]}"
  for dir in "${dirs[@]}"; do
    [[ $dir == '~/'* ]] && dir="$HOME/${dir#'~/'}"
    for path in "$dir"/*/; do
      [[ -d $path ]] && basename "$path"
    done
  done | sort -u
}

# Print "<words used> <name>" for the name the spoken words ($2...) refer to:
# the longest run of up to four words that, joined with "-", is a name, one
# edit from a name (a mishearing such as "crilling"), or the start of names.
# Without "from" dirs the picker takes the next word as is. Prints nothing when
# no name fits, so "skill set" or "this skill is" stay plain text.
pick_name() {
  local word=$1
  shift
  (($# > 0)) || return 0
  local -a spoken=("${@,,}")
  spoken=("${spoken[@]//[\'’]/}")
  if [[ -z ${COMPLETION_DIRS[$word]} ]]; then
    echo "1 ${spoken[0]}"
    return 0
  fi
  completion_names "$word" | awk -v words="${spoken[*]:0:4}" '
    function dist(a, b,   i, j, la, lb, d, x) {
      la = length(a); lb = length(b)
      for (i = 0; i <= la; i++) d[i, 0] = i
      for (j = 0; j <= lb; j++) d[0, j] = j
      for (i = 1; i <= la; i++)
        for (j = 1; j <= lb; j++) {
          x = d[i - 1, j - 1] + (substr(a, i, 1) != substr(b, j, 1))
          if (d[i - 1, j] + 1 < x) x = d[i - 1, j] + 1
          if (d[i, j - 1] + 1 < x) x = d[i, j - 1] + 1
          d[i, j] = x
        }
      return d[la, lb]
    }
    { names[++n] = $0 }
    END {
      m = split(words, w, " ")
      for (k = m; k >= 1; k--) {
        p = w[1]
        for (i = 2; i <= k; i++) p = p "-" w[i]
        for (i = 1; i <= n; i++) if (names[i] == p) { print k, p; exit }
        if (length(p) >= 5)
          for (i = 1; i <= n; i++) if (dist(names[i], p) <= 1) { print k, names[i]; exit }
        if (length(p) >= 3) {
          hits = 0
          for (i = 1; i <= n; i++) if (index(names[i], p) == 1) { hits++; hit = names[i] }
          if (hits) { print k, (hits == 1 ? hit : p); exit }
        }
      }
    }'
}

# Split text into PLAN steps: "text:<raw text>" to paste and
# "pick:<word>:<name>" to type into a picker. Returns 1 without any picker.
plan_completions() {
  local text=$1 pending="" lower word pick used next i
  local -a seps=() toks=()
  PLAN=()
  ((${#COMPLETIONS[@]} > 0)) || return 1
  while [[ $text =~ ^([^[:alnum:]]*)([[:alnum:]]+([\'’_-][[:alnum:]]+)*) ]]; do
    seps+=("${BASH_REMATCH[1]}")
    toks+=("${BASH_REMATCH[2]}")
    text=${text:${#BASH_REMATCH[0]}}
  done
  seps+=("$text")
  i=0
  while ((i < ${#toks[@]})); do
    lower=${toks[i],,}
    word=""
    if [[ -n ${COMPLETIONS[$lower]+set} ]]; then
      word=$lower
    elif [[ -n ${COMPLETIONS[${lower%s}]+set} ]]; then
      word=${lower%s}
    fi
    pick=""
    [[ -n $word ]] && pick=$(pick_name "$word" "${toks[@]:i+1}")
    if [[ -z $pick ]]; then
      pending+="${seps[i]}${toks[i]}"
      ((i++))
      continue
    fi
    used=${pick%% *}
    PLAN+=("text:$pending${seps[i]}" "pick:$word:${pick#* }")
    pending=""
    next=$((i + 1 + used))
    # Wispr sentence-cases "Skill review." -- a full stop straight after the
    # name is its artifact, not the user's.
    seps[next]=${seps[next]#.}
    i=$next
  done
  PLAN+=("text:$pending${seps[${#toks[@]}]}")
  [[ ${PLAN[*]} == *pick:* ]]
}

# Pause between typed keys, in seconds.
TYPE_DELAY=0.015

# Type text as key presses (letters, digits and the usual name punctuation).
type_keys() {
  local -a steps=()
  local c i
  for ((i = 0; i < ${#1}; i++)); do
    c=${1:i:1}
    case $c in
      [a-z0-9]) steps+=("$c") ;;
      [A-Z]) steps+=("SHIFT+${c,,}") ;;
      -) steps+=(minus) ;;
      _) steps+=(SHIFT+minus) ;;
      .) steps+=(period) ;;
      /) steps+=(slash) ;;
      :) steps+=(SHIFT+semicolon) ;;
      @) steps+=(SHIFT+2) ;;
      '#') steps+=(SHIFT+3) ;;
      '$') steps+=(SHIFT+4) ;;
    esac
  done
  if [[ -n $DRY_RUN ]]; then
    echo "type: $1"
    return
  fi
  # About 25 ms a key (hyprctl itself takes ~10): quick, but still visibly
  # typed. hk-voice-keys pauses 100 ms after each step.
  local step key mods
  for step in "${steps[@]}"; do
    key=${step##*+}
    mods=""
    [[ $step == *+* ]] && mods=${step%+*}
    hyprctl dispatch "hl.dsp.send_shortcut({ mods = '${mods//+/ }', key = '$key' })" >/dev/null
    sleep "$TYPE_DELAY"
  done
}

# Paste and type the PLAN. Takes a second or more, longer than the helper and
# Wispr wait (2 s and 3 s), so callers run it in the background.
run_plan() {
  local keys=$1 step word spec trigger accept
  for step in "${PLAN[@]}"; do
    case $step in
      text:) ;;
      text:*) paste_raw "$keys" "${step#text:}" ;;
      pick:*)
        step=${step#pick:}
        word=${step%%:*}
        spec=${COMPLETIONS[$word]}
        trigger=${spec%% *}
        accept=${spec#"$trigger"}
        type_keys "$trigger${step#*:}"
        if [[ -n $DRY_RUN ]]; then
          echo "then:${accept:- (none)}"
        else
          sleep 0.3
          # shellcheck disable=SC2086 # accept is a list of key steps
          [[ -n ${accept// /} ]] && hk-voice-keys $accept
        fi
        ;;
    esac
  done
  return 0
}

paste_and_send() {
  run_plan "$1" || true
  if [[ -n $DRY_RUN ]]; then
    echo "then Return"
  else
    hk-voice-keys Return
  fi
}

# Run a picker paste after this script has answered the helper (see above).
in_background() {
  if [[ -n $DRY_RUN ]]; then
    "$@"
  else
    # Let Wispr restore its clipboard first: it does so once this script answers.
    (sleep 0.5; "$@") </dev/null >/dev/null 2>&1 &
    disown
  fi
}

# A dictation ending in a send suffix ("Looks good, send it."): paste the rest,
# then press Enter. A suffix said on its own falls through to the commands.
FULL=$(normalize "$1")
for suffix in "${SUFFIXES[@]}"; do
  [[ $FULL == *" $suffix" ]] || continue
  # Cut the suffix words, and the punctuation around them, off the raw text.
  shopt -s nocasematch
  if [[ $1 =~ ^(.*[^[:space:][:punct:]][[:punct:]]*)[[:space:][:punct:]]+${suffix// /[^[:alnum:]]+}[[:space:][:punct:]]*$ ]]; then
    shopt -u nocasematch
    body="${BASH_REMATCH[1]}"
    join_previous
    start_fresh
    if plan_completions "${body%[,;:]}"; then
      in_background paste_and_send "${PASTE_KEY:-CTRL+V}"
    else
      PLAN=("text:${body%[,;:]}")
      paste_and_send "${PASTE_KEY:-CTRL+V}"
    fi
    exit 0
  fi
  shopt -u nocasematch
done

for line in "${APP_LINES[@]}" "${GLOBAL_LINES[@]}"; do
  phrase="${line%% = *}"
  command="${line#* = }"
  [[ ${phrase,,} == leader ]] && continue

  if match_phrase "$phrase" "$TRANSCRIPT"; then
    start_fresh
    run_command "$command"
    exit 0
  fi
done

# Not a command. If the focused app pastes with another key (terminals use
# Ctrl+Shift+V), paste the exact transcript here so the helper skips its Ctrl+V.
join_previous
remember_dictation
if plan_completions "$1"; then
  in_background run_plan "${PASTE_KEY:-CTRL+V}"
  exit 0
fi
if [[ -n $PASTE_KEY ]]; then
  paste_raw "$PASTE_KEY" "$1"
  exit 0
fi

exit 1
