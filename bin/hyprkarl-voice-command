#!/bin/bash

# Run a voice command from a dictation transcript.
# The Wispr Flow helper calls this (via WISPR_TRANSCRIPT_HOOK) with the transcript as $1.
# Exit 0: the transcript was a command and it was started, or it was pasted here
#         with the app's own paste key (terminals), so the helper skips the paste.
# Exit 1: not a command, so the helper pastes the transcript as normal text.
# Phrases live in $HYPRKARL_PATH/config/hyprkarl/voice-commands.conf; commands in an
# [app ...] section there apply only while that app's window is focused.

DRY_RUN=""
if [[ $1 == --dry-run ]]; then
  DRY_RUN=1
  shift
fi

# Tracks the window of the last dictation (for "join with") and any join mode
# set by voice. Lives in the runtime dir, so a reboot starts fresh.
STATE="${HYPRKARL_VOICE_STATE:-${XDG_RUNTIME_DIR:-/tmp}/hyprkarl-voice-state}"

# --join-mode line|paragraph|off|config: change the join mode until the next
# change ("config" goes back to the phrase file). Run by the "... mode" phrases.
if [[ $1 == --join-mode ]]; then
  if [[ $2 == config ]]; then
    rm -f "$STATE.mode"
  else
    printf '%s\n' "$2" >"$STATE.mode"
  fi
  [[ -n $DRY_RUN ]] || hyprctl notify 1 2000 0 "Dictation join: $2" >/dev/null
  exit 0
fi

if (($# == 0)); then
  echo "Usage: hyprkarl-voice-command [--dry-run] <transcript>"
  exit 1
fi

CONFIG="${HYPRKARL_VOICE_COMMANDS:-${HYPRKARL_PATH:-$HOME/.local/share/hyprkarl}/config/hyprkarl/voice-commands.conf}"
[[ -r $CONFIG ]] || exit 1

declare -A CAPTURES

# Lowercase, drop apostrophes, turn other punctuation into spaces, squeeze spaces.
normalize() {
  local text="${1,,}"
  text="${text//[\'’]/}"
  text="${text//[^a-z0-9]/ }"
  local -a words
  read -ra words <<<"$text"
  echo "${words[*]}"
}

# Print a spoken or written number as digits. Includes the usual mishearings.
to_number() {
  local names=(zero one two three four five six seven eight nine ten eleven
    twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen twenty)
  local i

  if [[ $1 =~ ^[0-9]+$ ]]; then
    echo "$1"
    return 0
  fi
  case $1 in
    won) echo 1; return 0 ;;
    to | too) echo 2; return 0 ;;
    for) echo 4; return 0 ;;
    file) echo 5; return 0 ;;
    ate) echo 8; return 0 ;;
  esac
  for i in "${!names[@]}"; do
    if [[ ${names[i]} == "$1" ]]; then
      echo "$i"
      return 0
    fi
  done
  return 1
}

# Match the whole transcript against one phrase, filling CAPTURES on success.
match_phrase() {
  local -a pwords twords
  local i

  read -ra pwords <<<"${1,,}"
  read -ra twords <<<"$2"
  CAPTURES=()
  for i in "${!pwords[@]}"; do
    ((i < ${#twords[@]})) || return 1
    case ${pwords[i]} in
      '<text>')
        CAPTURES[text]="${twords[*]:i}"
        return 0
        ;;
      '<n>')
        CAPTURES[n]=$(to_number "${twords[i]}") || return 1
        ;;
      *)
        [[ ${pwords[i]} == "${twords[i]}" ]] || return 1
        ;;
    esac
  done
  ((${#pwords[@]} == ${#twords[@]}))
}

# Fill placeholders into the command's words and start it detached.
run_command() {
  local -a argv
  local i

  read -ra argv <<<"$1"
  for i in "${!argv[@]}"; do
    argv[i]="${argv[i]//<n>/${CAPTURES[n]}}"
    argv[i]="${argv[i]//<text:url>/${CAPTURES[text]// /+}}"
    argv[i]="${argv[i]//<text>/${CAPTURES[text]}}"
    [[ ${argv[i]} == '~/'* ]] && argv[i]="$HOME/${argv[i]#'~/'}"
  done

  if [[ -n $DRY_RUN ]]; then
    printf '%q ' "${argv[@]}"
    echo
  else
    setsid -f "${argv[@]}" >/dev/null 2>&1
  fi
}

# Paste text into the focused app with the given keys. Not detached: the paste
# must land before the app restores its clipboard.
paste_raw() {
  local keys=$1 text=$2
  if [[ -n $DRY_RUN ]]; then
    echo "paste with $keys: $text"
    return
  fi
  printf '%s' "$text" | wl-copy
  sleep 0.05
  hyprkarl-voice-keys "$keys"
}

TRANSCRIPT=$(normalize "$1")

LEADER=$(sed -n 's/^[[:space:]]*leader[[:space:]]*=[[:space:]]*//p' "$CONFIG" | tail -n1)
LEADER=$(normalize "$LEADER")
# Without the leader nothing is a command (but it is still pasted, see below).
if [[ -n $LEADER ]]; then
  if [[ $TRANSCRIPT == "$LEADER "* ]]; then
    TRANSCRIPT="${TRANSCRIPT#"$LEADER "}"
  else
    TRANSCRIPT=""
  fi
fi

# The focused window's class (for [app ...] sections) and address (for joins).
# HYPRKARL_VOICE_CLASS / HYPRKARL_VOICE_ADDR override them for --dry-run tests.
if [[ -n ${HYPRKARL_VOICE_CLASS+set} ]]; then
  ACTIVE_CLASS=$HYPRKARL_VOICE_CLASS
  ACTIVE_ADDR=${HYPRKARL_VOICE_ADDR:-test}
else
  IFS=$'\t' read -r ACTIVE_CLASS ACTIVE_ADDR < <(hyprctl -j activewindow 2>/dev/null |
    jq -r '[.class // "", .address // ""] | @tsv')
fi

# Sort command lines into the focused app's sections and the global ones, so an
# app's command wins over a global command with the same phrase.
APP_LINES=()
GLOBAL_LINES=()
PASTE_KEY=""
SUFFIXES=()
JOIN_GLOBAL=""
JOIN_APP=""
section=global
while IFS= read -r line; do
  [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
  if [[ $line =~ ^[[:space:]]*\[(.*)\][[:space:]]*$ ]]; then
    header="${BASH_REMATCH[1]}"
    pattern="${header#app }"
    if [[ $header == global ]]; then
      section=global
    elif [[ $header == 'app '* && -n $ACTIVE_CLASS && ${ACTIVE_CLASS,,} =~ ^(${pattern,,})$ ]]; then
      section=app
    else
      section=other
    fi
    continue
  fi
  [[ $line == *' = '* ]] || continue
  if [[ $(normalize "${line%% = *}") == 'paste with' ]]; then
    [[ $section == app ]] && PASTE_KEY="${line#* = }"
    continue
  fi
  if [[ $(normalize "${line%% = *}") == 'join with' ]]; then
    case $section in
      global) JOIN_GLOBAL="${line#* = }" ;;
      app) JOIN_APP="${line#* = }" ;;
    esac
    continue
  fi
  if [[ $(normalize "${line%% = *}") == 'send suffix' ]]; then
    [[ $section == global ]] && SUFFIXES+=("$(normalize "${line#* = }")")
    continue
  fi
  case $section in
    app) APP_LINES+=("$line") ;;
    global) GLOBAL_LINES+=("$line") ;;
  esac
done <"$CONFIG"

# How this dictation joins the previous one: the app's section wins (so
# terminals stay off), then a mode set by voice, then the global setting.
JOIN_MODE=${JOIN_APP:-$(cat "$STATE.mode" 2>/dev/null)}
JOIN_MODE=${JOIN_MODE:-$JOIN_GLOBAL}
case ${JOIN_MODE,,} in
  line) JOIN_KEYS=(SHIFT+Return) ;;
  paragraph) JOIN_KEYS=(SHIFT+Return SHIFT+Return) ;;
  '' | off | space | none) JOIN_KEYS=() ;;
  *) read -ra JOIN_KEYS <<<"$JOIN_MODE" ;;
esac

# Wispr trims leading whitespace off every transcript, so it cannot start a
# dictation on a new line. Consecutive dictations into the same window get the
# join keys (Shift+Enter: a new line without sending) before they are pasted;
# another window or a voice command in between starts fresh.
join_previous() {
  ((${#JOIN_KEYS[@]} > 0)) && [[ -n $ACTIVE_ADDR ]] || return 0
  [[ $(cat "$STATE.last" 2>/dev/null) == "$ACTIVE_ADDR" ]] || return 0
  if [[ -n $DRY_RUN ]]; then
    echo "join: ${JOIN_KEYS[*]}"
  else
    hyprkarl-voice-keys "${JOIN_KEYS[@]}"
  fi
}

remember_dictation() {
  printf '%s\n' "$ACTIVE_ADDR" >"$STATE.last"
}

start_fresh() {
  rm -f "$STATE.last"
}

# A dictation ending in a send suffix ("Looks good, send it."): paste the rest,
# then press Enter. A suffix said on its own falls through to the commands.
FULL=$(normalize "$1")
for suffix in "${SUFFIXES[@]}"; do
  [[ $FULL == *" $suffix" ]] || continue
  # Cut the suffix words, and the punctuation around them, off the raw text.
  shopt -s nocasematch
  if [[ $1 =~ ^(.*[^[:space:][:punct:]][[:punct:]]*)[[:space:][:punct:]]+${suffix// /[^[:alnum:]]+}[[:space:][:punct:]]*$ ]]; then
    shopt -u nocasematch
    body="${BASH_REMATCH[1]}"
    join_previous
    paste_raw "${PASTE_KEY:-CTRL+V}" "${body%[,;:]}"
    if [[ -n $DRY_RUN ]]; then
      echo "then Return"
    else
      hyprkarl-voice-keys Return
    fi
    start_fresh
    exit 0
  fi
  shopt -u nocasematch
done

for line in "${APP_LINES[@]}" "${GLOBAL_LINES[@]}"; do
  phrase="${line%% = *}"
  command="${line#* = }"
  [[ $(normalize "$phrase") == leader ]] && continue

  if match_phrase "$phrase" "$TRANSCRIPT"; then
    start_fresh
    run_command "$command"
    exit 0
  fi
done

# Not a command. If the focused app pastes with another key (terminals use
# Ctrl+Shift+V), paste the exact transcript here so the helper skips its Ctrl+V.
join_previous
remember_dictation
if [[ -n $PASTE_KEY ]]; then
  paste_raw "$PASTE_KEY" "$1"
  exit 0
fi

exit 1
